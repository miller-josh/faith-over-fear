{
  "name": "faith-over-fear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private journaling web app for logging fears and answering each with truth and scripture.",
  "scripts": {
    "dev": "vercel dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@clerk/backend": "^1.21.6",
    "@clerk/clerk-react": "^5.22.1",
    "@clerk/types": "^4.49.0",
    "@neondatabase/serverless": "^0.10.4",
    "@tanstack/react-query": "^5.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^5.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
