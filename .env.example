# ─────────────────────────────────────────────────────────────────────────────
# Faith over Fear — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk — https://dashboard.clerk.com  (API Keys)
# The publishable key is exposed to the browser; it MUST be prefixed VITE_.
VITE_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# Neon Postgres — https://console.neon.tech  (Connection string, "pooled")
DATABASE_URL=<your-neon-pooled-connection-string>

# Anthropic (AI verse suggestion) — https://console.anthropic.com
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional: override the model used for verse suggestions.
# Default is claude-opus-5. For lower latency you can use claude-sonnet-5
# or claude-haiku-4-5.
# SUGGEST_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────────────────────
# Bible translations (per-verse selection: ESV, KJV, NIV, NKJV, NASB)
# ─────────────────────────────────────────────────────────────────────────────
# KJV is public domain and works with no key. ESV, NIV, NKJV, and NASB are
# copyrighted and need a licensed provider key below; until a key is present the
# app shows a "not set up yet" note in place of that translation's text.

# Optional: default translation for newly-added verses. Defaults to kjv (the
# only key-free option). One of: esv | kjv | niv | nkjv | nasb.
# BIBLE_TRANSLATION=kjv

# ESV / NIV / NKJV / NASB — API.Bible: https://scripture.api.bible/
#
# API.Bible uses ONE shared key for ALL versions. You do NOT set a separate key
# per translation — you set the single API_BIBLE_KEY, then give each version the
# bible id that tells the key which translation to return. Find a version's id in
# your API.Bible dashboard (or GET /v1/bibles). Set only the ids you've licensed;
# any version without an id shows the "not set up yet" note.
# API_BIBLE_KEY=<your-api-bible-key>
# API_BIBLE_ID_ESV=<api-bible-bible-id-for-esv>
# API_BIBLE_ID_NIV=<api-bible-bible-id-for-niv>
# API_BIBLE_ID_NKJV=<api-bible-bible-id-for-nkjv>
# API_BIBLE_ID_NASB=<api-bible-bible-id-for-nasb>
#
# ESV alternative: Crossway's own ESV API (https://api.esv.org/, free for
# personal use) is used instead of API.Bible for ESV when this is set.
# ESV_API_KEY=<your-esv-api-key>
